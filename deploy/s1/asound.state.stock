state.comipsndsoc {
	control.1 {
		iface MIXER
		name 'DACR Input'
		value I2SR
		comment {
			access 'read write'
			type ENUMERATED
			count 1
			item.0 I2SL
			item.1 I2SR
			item.2 PCML
			item.3 PCMR
			item.4 ZERO
		}
	}
	control.2 {
