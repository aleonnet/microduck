#!/bin/sh
# O S1 em um comando: sobe a página e fica aguardando o robô. Tudo o mais acontece na página, inclusive ativar o robô real.
#
#   scripts/rms1          sobe, abre o navegador e fica em primeiro plano; Ctrl-C encerra tudo
#   scripts/rms1 down     encerra o que outro terminal subiu
#
# Nunca usa o Python do terminal: o serviço roda por `uv`, com a versão de `websockets` fixada no laboratório.
set -eu

REPO="$(cd "$(dirname "$0")/.." && pwd)"
LAB="${S1_LAB:-$HOME/Development/RoboMaster-S1}"
ESTADO="${RMS1_ESTADO:-/tmp/rms1}"
PORTA_PAGINA="${RMS1_PORTA_PAGINA:-8765}"
PORTA_WS="${RMS1_PORTA_WS:-8766}"
PORTA_TCP="${RMS1_PORTA_TCP:-9000}"
PORTA_QUADROS="${RMS1_PORTA_QUADROS:-9100}"
PAGINA="http://127.0.0.1:$PORTA_PAGINA/viewer/"
ESPERA_PAGINA_S=120

diz() { echo "[rms1] $*"; }
falha() {
    echo "[rms1] PAROU: $*" >&2
    exit 1
}

# O pid guardado pode ser de outro processo, depois de um reinício do Mac: só encerra se ainda for o nosso.
e_nosso() { # e_nosso <pid> <o que o comando tem de conter>
    ps -o command= -p "$1" 2>/dev/null | grep -q "$2"
}

# O serviço morto de repente não encerra o filho: o `rms1d` ficaria com a trava do socket, e a próxima subida morreria nela.
limpar_rms1d() {
    [ -s "$ESTADO/rms1d.pid" ] || return 0
    orfao="$(cat "$ESTADO/rms1d.pid")"
    if e_nosso "$orfao" rms1d; then kill "$orfao" 2>/dev/null || true; fi
    : > "$ESTADO/rms1d.pid"
}

# Nem a ponte até o robô, nem a porta do `adb`. Só neste Mac: o robô, quem devolve é "Voltar ao modo DJI".
limpar_ponte() {
    [ -s "$ESTADO/bancada/ponte.pid" ] || return 0
    orfao="$(cat "$ESTADO/bancada/ponte.pid")"
    e_nosso "$orfao" rms1d-ponte || return 0
    kill "$orfao" 2>/dev/null || true
    if [ -s "$ESTADO/bancada/robo_tocado" ]; then
        S1_HOST="$(cat "$ESTADO/bancada/robo_tocado")" S1_ESTADO="$ESTADO/bancada" bash "$REPO/scripts/s1/rms1d-bench.sh" solta 2>/dev/null || true
    fi
}

limpar_arquivos() {
    : > "$ESTADO/servico.pid"
    : > "$ESTADO/rms1.pid"
}

parar() {
    [ -d "$ESTADO" ] || return 0
    alvos=""
    if [ -s "$ESTADO/rms1.pid" ] && e_nosso "$(cat "$ESTADO/rms1.pid")" rms1; then alvos="$(cat "$ESTADO/rms1.pid")"; fi
    # O comando já morreu, e o serviço ficou: encerra direto.
    if [ -z "$alvos" ] && [ -s "$ESTADO/servico.pid" ] && e_nosso "$(cat "$ESTADO/servico.pid")" s1_servico; then alvos="$(cat "$ESTADO/servico.pid")"; fi
    for p in $alvos; do kill "$p" 2>/dev/null || true; done
    n=0
    for p in $alvos; do
        while kill -0 "$p" 2>/dev/null; do
            n=$((n + 1))
            [ "$n" -lt 150 ] || falha "o processo $p não saiu em 15 s"
            sleep 0.1
        done
    done
    limpar_rms1d
    limpar_ponte
    limpar_arquivos
}

conferir() {
    command -v uv >/dev/null 2>&1 || falha "falta o uv. Instale com: brew install uv"
    command -v cargo >/dev/null 2>&1 || falha "falta o cargo. Instale o Rust em https://rustup.rs"
    [ -f "$LAB/tools/simulador/s1_servico.py" ] || falha "não achei o laboratório em $LAB. Aponte com S1_LAB=<pasta>"
    for porta in "$PORTA_PAGINA" "$PORTA_WS" "$PORTA_TCP" "$PORTA_QUADROS"; do
        if lsof -nP -iTCP:"$porta" -sTCP:LISTEN >/dev/null 2>&1; then
            quem="$(lsof -nP -iTCP:"$porta" -sTCP:LISTEN | awk 'NR==2 {print $1 ", processo " $2}')"
            falha "a porta $porta está ocupada por $quem. Encerre esse processo ou rode scripts/rms1 down"
        fi
    done
}

morreu() {
    limpar_rms1d
    limpar_ponte
    limpar_arquivos
    echo "[rms1] o serviço parou. O que ele disse:" >&2
    tail -15 "$ESTADO/servico.log" >&2
    falha "o serviço terminou com erro $1"
}

encerrar() {
    if [ -n "${compilando:-}" ]; then kill "$compilando" 2>/dev/null || true; fi
    if [ -n "${pid:-}" ]; then
        kill "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    fi
    limpar_rms1d
    limpar_ponte
    limpar_arquivos
    diz "encerrado"
    exit 0
}

subir() {
    conferir
    mkdir -p "$ESTADO"
    limpar_rms1d
    echo "$$" > "$ESTADO/rms1.pid"
    trap encerrar INT TERM HUP
    diz "compilando o rms1d, a primeira vez leva alguns minutos"
    (cd "$REPO" && exec cargo build --quiet -p rms1d) &
    compilando=$!
    wait "$compilando" || falha "a compilação falhou; o erro está acima"
    compilando=""
    VERSAO="$(sed -n 's/^websockets==//p' "$LAB/tools/requirements.txt")"
    diz "subindo o serviço local"
    uv run --no-project --python 3.11 --with "websockets==$VERSAO" python "$LAB/tools/simulador/s1_servico.py" \
        --microduck "$REPO" --estado "$ESTADO" \
        --porta-pagina "$PORTA_PAGINA" --ws "$PORTA_WS" --tcp "$PORTA_TCP" --quadros "$PORTA_QUADROS" \
        > "$ESTADO/servico.log" 2>&1 &
    pid=$!
    echo "$pid" > "$ESTADO/servico.pid"
    n=0
    until curl -fs --max-time 2 --noproxy '*' -o /dev/null "$PAGINA"; do
        if ! kill -0 "$pid" 2>/dev/null; then
            rc=0
            wait "$pid" || rc=$?
            morreu "$rc"
        fi
        n=$((n + 1))
        if [ "$n" -gt $((ESPERA_PAGINA_S * 10)) ]; then
            kill "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            morreu "a página não respondeu em $ESPERA_PAGINA_S s"
        fi
        sleep 0.1
    done
    diz "no ar: $PAGINA"
    if [ -z "${RMS1_SEM_ABRIR:-}" ] && command -v open >/dev/null 2>&1; then
        open "$PAGINA" || diz "não consegui abrir o navegador; abra $PAGINA"
    fi
    diz "aguardando o robô na rede. Ctrl-C encerra tudo."
    rc=0
    wait "$pid" || rc=$?
    [ "$rc" = 0 ] || morreu "$rc"
    limpar_arquivos
}

case "${1:-up}" in
    up) subir ;;
    down)
        parar
        diz "encerrado"
        ;;
    *)
        sed -n 2,6p "$0"
        exit 2
        ;;
esac
